{
  "expo": {
    "name": "Integres Blacklist",
    "slug": "integres-blacklist",
    "scheme": "integresblacklist",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.integres.integresblacklist",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Select evidence you choose to submit for a confidential report or dispute."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.integres.integresblacklist",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-document-picker",
      "expo-image-picker",
      "expo-secure-store",
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "91b769e1-e8fc-4e2a-94ee-252a742fe948"
      }
    },
    "runtimeVersion": {"policy": "appVersion"},
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/91b769e1-e8fc-4e2a-94ee-252a742fe948"
    }
  }
}
